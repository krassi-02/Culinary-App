rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny all undefined paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
      allow write: if false;
    }

    // User Profile Document
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // Strict PII protection: never allow user enumeration
      
      allow create: if isOwner(userId) && isValidId(userId)
        && incoming().userId == request.auth.uid;

      allow update: if isOwner(userId) && isValidId(userId)
        && incoming().userId == existing().userId;

      allow delete: if isOwner(userId) && isValidId(userId);

      // User Personal Recipe Vault
      match /recipes/{recipeId} {
        allow read, write: if isOwner(userId) && isValidId(recipeId);
      }

      // User Fridge & Pantry Inventory
      match /fridge/{itemId} {
        allow read, write: if isOwner(userId) && isValidId(itemId);
      }

      // User Grocery Cart
      match /grocery/{itemId} {
        allow read, write: if isOwner(userId) && isValidId(itemId);
      }
    }
  }
}
