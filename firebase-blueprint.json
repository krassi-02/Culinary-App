{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with dietary preferences, macro targets, and kitchen settings",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The Firebase Auth user ID"
        },
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "description": "User display name"
        },
        "photoURL": {
          "type": "string",
          "description": "User profile avatar photo URL"
        },
        "dietaryPreferences": {
          "type": "array",
          "description": "List of active dietary preferences or restrictions"
        },
        "macroTargets": {
          "type": "object",
          "description": "Target daily macronutrient goals (dailyCalories, proteinGrams, carbsGrams, fatGrams)"
        },
        "defaultServings": {
          "type": "number",
          "description": "Default recipe scaling servings"
        },
        "measurementSystem": {
          "type": "string",
          "enum": ["metric", "imperial"],
          "description": "Preferred unit system"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of profile creation"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last profile update"
        }
      },
      "required": ["userId", "email"]
    },
    "UserRecipe": {
      "title": "UserRecipe",
      "description": "Recipe stored in user's personal vault",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "sourceUrl": {
          "type": "string"
        },
        "sourceType": {
          "type": "string"
        },
        "imageUrl": {
          "type": "string"
        },
        "prepTimeMinutes": {
          "type": "number"
        },
        "cookTimeMinutes": {
          "type": "number"
        },
        "standardServings": {
          "type": "number"
        },
        "ingredients": {
          "type": "array"
        },
        "instructions": {
          "type": "array"
        },
        "nutritionPerServing": {
          "type": "object"
        },
        "tags": {
          "type": "array"
        },
        "cuisine": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": ["id", "userId", "title"]
    },
    "UserFridgeItem": {
      "title": "UserFridgeItem",
      "description": "Pantry and fridge inventory item for user",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "quantity": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "expiresInDays": {
          "type": "number"
        },
        "addedAt": {
          "type": "string"
        }
      },
      "required": ["id", "userId", "name", "quantity", "unit"]
    },
    "UserGroceryItem": {
      "title": "UserGroceryItem",
      "description": "Active shopping cart item for user",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "quantity": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "recipeSource": {
          "type": "string"
        },
        "purchased": {
          "type": "boolean"
        }
      },
      "required": ["id", "userId", "name", "quantity", "unit"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Private profile document for each authenticated user"
    },
    "/users/{userId}/recipes/{recipeId}": {
      "schema": "UserRecipe",
      "description": "Personal recipe collection for the user"
    },
    "/users/{userId}/fridge/{itemId}": {
      "schema": "UserFridgeItem",
      "description": "Pantry and fridge inventory for the user"
    },
    "/users/{userId}/grocery/{itemId}": {
      "schema": "UserGroceryItem",
      "description": "Grocery shopping items for the user"
    }
  }
}
